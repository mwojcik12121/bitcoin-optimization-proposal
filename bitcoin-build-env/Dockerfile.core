# syntax=docker/dockerfile:1.7

ARG DEBIAN_IMAGE=debian:bookworm-slim
FROM ${DEBIAN_IMAGE} AS build

ARG BITCOIN_SOURCE_REPOSITORY=bitcoin
ARG BITCOIN_SOURCE_REVISION=unversioned
ARG BITCOIN_BUILD_JOBS=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential ca-certificates cmake libboost-dev libevent-dev libsqlite3-dev \
       pkgconf python3 \
    && rm -rf /var/lib/apt/lists/*

COPY src/ /src/repositories/

RUN --network=none set -eu; \
    case "$BITCOIN_SOURCE_REPOSITORY" in \
      ''|*[!A-Za-z0-9._-]*|.|..) echo "Invalid Bitcoin source repository name" >&2; exit 1 ;; \
    esac; \
    test -n "$BITCOIN_SOURCE_REVISION"; \
    case "$BITCOIN_BUILD_JOBS" in ''|*[!0-9]*|0) echo "BITCOIN_BUILD_JOBS must be positive" >&2; exit 1 ;; esac; \
    source_dir="/src/repositories/${BITCOIN_SOURCE_REPOSITORY}"; \
    test -f "${source_dir}/CMakeLists.txt"; \
    test -f "${source_dir}/COPYING"; \
    test -f "${source_dir}/src/bitcoind.cpp"; \
    test -f "${source_dir}/src/bitcoin-cli.cpp"; \
    cmake -S "$source_dir" -B /build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/install/usr/local \
      -DBUILD_BITCOIN_BIN=ON \
      -DBUILD_DAEMON=ON \
      -DBUILD_CLI=ON \
      -DBUILD_TX=ON \
      -DBUILD_UTIL=ON \
      -DBUILD_WALLET_TOOL=ON \
      -DBUILD_GUI=OFF \
      -DBUILD_GUI_TESTS=OFF \
      -DBUILD_TESTS=OFF \
      -DBUILD_BENCH=OFF \
      -DBUILD_FUZZ_BINARY=OFF \
      -DBUILD_KERNEL_LIB=OFF \
      -DBUILD_UTIL_CHAINSTATE=OFF \
      -DENABLE_WALLET=ON \
      -DENABLE_EXTERNAL_SIGNER=OFF \
      -DENABLE_IPC=OFF \
      -DWITH_ZMQ=OFF \
      -DWITH_USDT=OFF \
      -DWITH_CCACHE=OFF \
      -DINSTALL_MAN=OFF; \
    cmake --build /build --parallel "$BITCOIN_BUILD_JOBS"; \
    cmake --install /build; \
    install -d -m 0755 /artifact/usr/local/bin /artifact/opt/bitcoin; \
    for binary in bitcoin bitcoind bitcoin-cli bitcoin-tx bitcoin-util bitcoin-wallet; do \
      test -x "/install/usr/local/bin/${binary}"; \
      install -m 0755 "/install/usr/local/bin/${binary}" "/artifact/usr/local/bin/${binary}"; \
    done; \
    install -m 0644 "${source_dir}/COPYING" /artifact/opt/bitcoin/COPYING; \
    printf '%s\n' "$BITCOIN_SOURCE_REPOSITORY" > /artifact/opt/bitcoin/SOURCE_REPOSITORY; \
    printf '%s\n' "$BITCOIN_SOURCE_REVISION" > /artifact/opt/bitcoin/SOURCE_REVISION; \
    dpkg --print-architecture > /artifact/opt/bitcoin/ARCHITECTURE; \
    /artifact/usr/local/bin/bitcoind --version | head -n 1 > /artifact/opt/bitcoin/VERSION

FROM scratch AS binaries
COPY --from=build /artifact/ /
